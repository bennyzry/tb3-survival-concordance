+def _tie_boundaries(keys, tolerance):
+    """Find inclusive bands with the *actual dtype's subtraction predicate*.
+
+    Substituting searchsorted(center +/- tolerance) is not equivalent at some
+    floating-point boundaries. Batched binary searches cost O(u log u), use
+    O(u) storage, and preserve the original NumPy subtraction/abs/comparison.
+    """
+    size = len(keys)
+    index = np.arange(size, dtype=np.intp)
+    lower = np.zeros(size, dtype=np.intp)
+    end = index.copy()
+    with np.errstate(over='ignore', invalid='ignore'):
+        while np.any(lower < end):
+            active = np.flatnonzero(lower < end)
+            mid = lower[active] + (end[active] - lower[active]) // 2
+            tied = np.absolute(keys[mid] - keys[active]) <= tolerance
+            end[active[tied]] = mid[tied]
+            lower[active[~tied]] = mid[~tied] + 1
+        upper = index + 1
+        end = np.full(size, size, dtype=np.intp)
+        while np.any(upper < end):
+            active = np.flatnonzero(upper < end)
+            mid = upper[active] + (end[active] - upper[active]) // 2
+            tied = np.absolute(keys[mid] - keys[active]) <= tolerance
+            upper[active[tied]] = mid[tied] + 1
+            end[active[~tied]] = mid[~tied]
+    return lower, upper
+
