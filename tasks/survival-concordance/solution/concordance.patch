+        return _estimate_concordance_index_quadratic(event_indicator, event_time, estimate, weights, tied_tol)
+
+    # Preserve legacy warning/error behavior for extreme finite magnitudes
+    # whose subtraction overflows, instead of precomputing unused comparisons.
